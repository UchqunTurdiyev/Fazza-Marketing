# ===== Sayt =====
NEXT_PUBLIC_SITE_URL=https://strategiya.fazza.uz

# ===== Meta Pixel + Conversions API =====
# Pixel ID (brauzer va server uchun bir xil)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=
# Test paytida Events Manager -> Test events dagi kod (ishga tushgach bo'sh qoldiring)
META_TEST_EVENT_CODE=
META_API_VERSION=v23.0
# Purchase eventi uchun action_source: website | system_generated | physical_store | other
META_PURCHASE_ACTION_SOURCE=website
# true bo'lsa: foydalanuvchi marketing cookie'ga rozilik bermagan bo'lsa Lead CAPI yuborilmaydi
META_CAPI_REQUIRE_CONSENT=false

# ===== Telegram bot =====
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=
# Bir nechta chat bo'lsa vergul bilan: -1001234567890,123456789
TELEGRAM_CHAT_IDS=

# ===== Bitrix24 =====
# Kiruvchi vebhuk (crm huquqi bilan): https://xxxx.bitrix24.uz/rest/1/abcdef123456/
BITRIX24_WEBHOOK_URL=
# Mas'ul xodim ID (ixtiyoriy)
BITRIX24_ASSIGNED_BY_ID=
# Chiquvchi vebhuk (ONCRMDEALUPDATE) "application_token" qiymati
BITRIX24_APP_TOKEN=
# Robot/vebhuk orqali Purchase chaqirish uchun maxfiy kalit (uzun tasodifiy satr)
PURCHASE_WEBHOOK_SECRET=
# Bitrix'dagi bitim valyutasi bo'sh bo'lsa ishlatiladi
DEFAULT_CURRENCY=USD
